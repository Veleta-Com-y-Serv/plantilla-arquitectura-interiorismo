---
// Página no encontrada: banda oscura a pantalla casi completa con el número en sans ligera enorme.
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="banda-oscura en-oscuro reticula flex min-h-[80svh] items-center">
    <div class="contenedor py-20">
      <p class="antetitulo">Error 404</p>
      <p class="numero mt-6 text-[clamp(7rem,30vw,22rem)] leading-[.8] text-acento" aria-hidden="true">404</p>
      <h1 class="titulo-seccion mt-8 max-w-[16ch]">Esta página no está en el plano</h1>
      <p class="titular-texto">Puede que el enlace esté mal o que la página se haya movido.</p>
      <p class="mt-10"><a class="btn" href="/">Volver al inicio <span class="flecha" aria-hidden="true">→</span></a></p>
    </div>
  </section>
</Base>
