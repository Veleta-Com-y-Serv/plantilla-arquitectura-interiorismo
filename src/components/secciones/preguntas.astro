---
// Preguntas frecuentes: banda clara partida; el titular a la izquierda y el acordeón nativo <details>
// a la derecha, con filetes y un signo + que se vuelve − al abrir. Sin preguntas no se pinta.
// Campos: antetitulo, titulo, texto, `preguntas[]` {pregunta, respuesta}.
// También sirve de diseño para apartados nuevos (`tipo: preguntas`).
import { seccion, orden } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
---

{
  s && preguntas.length > 0 && (
    <Seccion id={id} banda="clara">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-0" />
        </div>
        <div class="border-b border-[var(--c-linea)] lg:col-span-7">
          {preguntas.map((p, i) => (
            <details class="faq border-t border-[var(--c-linea)]">
              <summary class="flex min-h-[3rem] items-start gap-4 py-6 md:gap-6 md:py-8">
                <span class="numero mt-1 w-8 shrink-0 text-sm text-acento">{orden(i)}</span>
                <span class="flex-1 font-display text-xl leading-snug font-light tracking-tight md:text-[1.75rem]">{p.pregunta}</span>
                <span class="faq-signo mt-1" aria-hidden="true" />
              </summary>
              {p.respuesta && <p class="max-w-2xl pb-8 pl-12 text-[var(--c-suave)] md:pl-14 md:text-lg">{p.respuesta}</p>}
            </details>
          ))}
        </div>
      </div>
    </Seccion>
  )
}
