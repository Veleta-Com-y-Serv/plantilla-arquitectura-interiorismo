---
// Proyectos: mosaico asimétrico de borde a borde (sin márgenes) con pie sobre la foto y filtro por categoría.
// Campos: antetitulo, titulo, texto y `proyectos[]` {titulo, texto, lugar, anio, imagen, categoria}.
// El filtro sale solo si hay dos categorías o más (botones con un script pequeño en línea; sin JavaScript se ven todos).
// También sirve de diseño para apartados nuevos (`tipo: proyectos`).
import { seccion, orden } from '../../data/site';
import { altFicha } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const proyectos = s ? s.proyectos.filter((p) => p && p.titulo) : [];
const categorias = [...new Set(proyectos.map((p) => (p.categoria ?? '').trim()).filter(Boolean))];

// Tamaño de cada pieza en la rejilla de 6 columnas (columnas, filas): bloques de seis con una grande,
// dos pequeñas, una alta y dos apaisadas; lo que sobra al final se reparte para no dejar huecos.
const RESTO: Record<number, [number, number][]> = {
  1: [[6, 2]],
  2: [[3, 2], [3, 2]],
  3: [[4, 2], [2, 1], [2, 1]],
  4: [[4, 2], [2, 1], [2, 1], [6, 1]],
  5: [[4, 2], [2, 1], [2, 1], [3, 1], [3, 1]],
};
const BLOQUE: [number, number][] = [[4, 2], [2, 1], [2, 1], [2, 2], [4, 1], [4, 1]];
const enteros = Math.floor(proyectos.length / 6) * 6;
const tam = proyectos.map((_, i) => (i < enteros ? BLOQUE[i % 6] : RESTO[proyectos.length - enteros][i - enteros]));
const clave = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-');
---

{
  s && (
    <Seccion id={id} banda="clara" sinContenedor class="!pb-0">
      <div class="contenedor">
        <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-0" />
          {categorias.length > 1 && (
            <div class="filtros -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 md:mx-0 md:flex-wrap md:px-0 lg:max-w-[32rem] lg:justify-end" role="group" aria-label="Filtrar proyectos por tipo" data-filtros={id}>
              <button type="button" class="filtro" aria-pressed="true" data-filtro="">Todos</button>
              {categorias.map((c) => <button type="button" class="filtro" aria-pressed="false" data-filtro={clave(c)}>{c}</button>)}
            </div>
          )}
        </div>
      </div>
      {proyectos.length > 0 && (
        <ul class="mosaico mt-12 md:mt-16" data-mosaico={id}>
          {proyectos.map((p, i) => (
            <li style={`--col:${tam[i][0]};--fil:${tam[i][1]}`} data-categoria={clave(p.categoria ?? '')}>
              <figure>
                <Imagen src={p.imagen} alt={altFicha(p)} ancho={tam[i][0] >= 4 ? 1600 : 900} alto={tam[i][1] === 2 ? 1100 : 700} />
                <figcaption>
                  <p class="etiqueta flex items-center gap-3 text-white/80">
                    <span class="numero text-base tracking-normal">{orden(i)}</span>
                    {p.categoria && <span>{p.categoria}</span>}
                  </p>
                  <h3 class="mt-3 text-[1.75rem] md:text-[clamp(1.6rem,2.4vw,2.6rem)]">{p.titulo}</h3>
                  {(p.lugar || p.anio) && <p class="mt-2 text-sm text-white/80">{[p.lugar, p.anio].filter(Boolean).join(' · ')}</p>}
                  {p.texto && <p class="mt-3 line-clamp-2 max-w-xl text-sm text-white/75">{p.texto}</p>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )}
    </Seccion>
  )
}

<script is:inline>
  document.querySelectorAll('[data-filtros]').forEach(function (grupo) {
    var lista = document.querySelector('[data-mosaico="' + grupo.getAttribute('data-filtros') + '"]');
    if (!lista) return;
    grupo.addEventListener('click', function (e) {
      var b = e.target.closest('[data-filtro]');
      if (!b) return;
      var f = b.getAttribute('data-filtro');
      grupo.querySelectorAll('[data-filtro]').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      lista.querySelectorAll('li').forEach(function (li) { li.hidden = !!f && li.getAttribute('data-categoria') !== f; });
    });
  });
</script>
