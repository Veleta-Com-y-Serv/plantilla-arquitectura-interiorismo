---
// Cómo trabajamos: banda clara con papel milimetrado; los pasos van en línea de tiempo horizontal en escritorio
// (una línea de cota los une, con un cuadro de acento en cada paso) y en vertical en móvil.
// Campos: antetitulo, titulo, texto, `items[]` {titulo, texto, duracion}.
// También sirve de diseño para apartados nuevos (`tipo: proceso`).
import { seccion, orden } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const pasos = s ? s.items.filter((it) => it && it.titulo) : [];
const n = Math.min(Math.max(pasos.length, 1), 5);
---

{
  s && (
    <Seccion id={id} banda="papel">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      {pasos.length > 0 && (
        <ol class="pasos grid gap-0 md:mt-20" style={`--pasos:${n}`}>
          {pasos.map((p, i) => (
            <li class="paso relative grid grid-cols-[3.25rem_1fr] gap-x-4 pb-12 last:pb-0 lg:block lg:pr-8 lg:pb-0">
              <span class="paso-marca" aria-hidden="true" />
              <span class="numero relative z-10 self-start bg-[var(--c-papel)] pr-2 text-5xl text-acento lg:inline-block lg:pr-4 lg:text-7xl">{orden(i)}</span>
              <div class="lg:mt-10">
                {p.duracion && <p class="etiqueta text-[var(--c-suave)]">{p.duracion}</p>}
                <h3 class="mt-3 text-[1.75rem] lg:text-[2rem]">{p.titulo}</h3>
                {p.texto && <p class="mt-3 max-w-sm text-[var(--c-suave)]">{p.texto}</p>}
              </div>
            </li>
          ))}
        </ol>
      )}
    </Seccion>
  )
}

<style>
  /* Móvil: línea vertical a la izquierda; escritorio: línea horizontal bajo los números. */
  .paso-marca { position: absolute; left: 1.45rem; top: 3.5rem; bottom: .75rem; width: 1px; background: color-mix(in srgb, var(--c-texto) 30%, transparent); }
  .paso:last-child .paso-marca { display: none; }
  @media (min-width: 1024px) {
    .pasos { grid-template-columns: repeat(var(--pasos), minmax(0, 1fr)); }
    .paso-marca { left: 0; right: 0; top: 2.4rem; bottom: auto; width: auto; height: 1px; display: block !important; }
    .paso-marca::after { content: ""; position: absolute; right: 2rem; top: -5px; width: 11px; height: 11px; background: var(--c-acento); }
    .paso:last-child .paso-marca { right: 2rem; }
    .paso:last-child .paso-marca::after { right: -6px; }
  }
</style>
