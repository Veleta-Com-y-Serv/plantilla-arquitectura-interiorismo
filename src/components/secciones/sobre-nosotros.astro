---
// El estudio: fila 50/50 con la foto a sangre (toca el borde izquierdo de la ventana) y el texto al otro lado;
// debajo, el equipo en cuatro columnas con retrato en blanco y negro.
// Campos: antetitulo, titulo, texto (párrafos), imagen, `personas[]` {nombre, cargo, foto, texto}.
// También sirve de diseño para apartados nuevos (`tipo: sobre-nosotros`).
import { seccion, parrafos, orden } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const personas = s ? s.personas.filter((p) => p && p.nombre) : [];
const texto = parrafos(s?.texto);
---

{
  s && (
    <Seccion id={id} banda="clara" sinContenedor class="!pt-0 md:!pt-0">
      <div class:list={['grid', s.imagen && 'lg:grid-cols-2']}>
        {s.imagen && (
          <div class="relative min-h-[22rem] lg:min-h-[44rem]">
            <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1400} alto={1400} class="absolute inset-0 h-full w-full object-cover" />
          </div>
        )}
        <div class:list={['px-4 pt-16 md:px-8 lg:pt-28', s.imagen ? 'lg:px-16 xl:px-24' : 'contenedor']}>
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          {s.titulo && <h2 class="titulo-seccion max-w-[14ch]">{s.titulo}</h2>}
          {texto.length > 0 && (
            <div class="mt-10 max-w-xl space-y-5 text-lg leading-relaxed text-[var(--c-suave)]">
              {texto.map((p, i) => <p class={i === 0 ? 'text-texto text-xl' : ''}>{p}</p>)}
            </div>
          )}
        </div>
      </div>
      {personas.length > 0 && (
        <div class="contenedor mt-20 md:mt-28">
          <ul class="grid grid-cols-2 gap-x-4 gap-y-12 md:grid-cols-4 md:gap-x-6 lg:gap-x-8">
            {personas.map((p, i) => (
              <li>
                <Imagen src={p.foto || '/placeholders/persona.svg'} alt={p.nombre} ancho={600} alto={800} class="aspect-[3/4] w-full object-cover grayscale" />
                <p class="mt-5 flex items-baseline gap-3">
                  <span class="numero text-sm text-acento">{orden(i)}</span>
                  <span class="font-display text-xl font-light tracking-tight md:text-2xl">{p.nombre}</span>
                </p>
                {p.cargo && <p class="etiqueta mt-2 text-[var(--c-suave)]">{p.cargo}</p>}
                {p.texto && <p class="mt-3 text-sm text-[var(--c-suave)]">{p.texto}</p>}
              </li>
            ))}
          </ul>
        </div>
      )}
    </Seccion>
  )
}
