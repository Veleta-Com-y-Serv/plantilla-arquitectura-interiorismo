---
// Titular de sección (antetítulo con línea + título grande + entradilla). Adaptado de AstroWind (Headline.astro), © onWidget, MIT.
// `lado`: con algo a la derecha (filtros, botón) el titular ocupa la columna izquierda.
interface Props { titulo?: string; antetitulo?: string; texto?: string; alinear?: 'izquierda' | 'centro'; class?: string; nivel?: 1 | 2 }
const { titulo, antetitulo, texto, alinear = 'izquierda', class: clase = '', nivel = 2 } = Astro.props;
const H = nivel === 1 ? 'h1' : 'h2';
---

{
  (titulo || antetitulo || texto) && (
    <div class:list={['titular', { 'titular--centro': alinear === 'centro' }, clase]}>
      {antetitulo && <p class:list={['antetitulo', { 'justify-center': alinear === 'centro' }]}>{antetitulo}</p>}
      {titulo && <H class="titulo-seccion">{titulo}</H>}
      {texto && <p class:list={['titular-texto', { 'mx-auto': alinear === 'centro' }]}>{texto}</p>}
    </div>
  )
}
